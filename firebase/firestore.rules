rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userData().role == 'admin';
    }

    function isSupervisor() {
      return signedIn() && userData().role == 'supervisor';
    }

    function isDriver() {
      return signedIn() && userData().role == 'driver';
    }

    function isStaff() {
      return isAdmin() || isSupervisor() || isDriver();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isSupervisor()
        || (signedIn() && request.auth.uid == userId);

      allow create: if isAdmin()
        || (isSupervisor() && request.resource.data.role == 'driver')
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'customer');

      allow update, delete: if isAdmin()
        || (isSupervisor() && resource.data.role == 'driver')
        || (signedIn() && request.auth.uid == userId);
    }

    // Public branch list for signup nearest-branch selection.
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || isSupervisor()
        || (isDriver() && resource.data.riderId == request.auth.uid)
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'customerId', 'branchId', 'productId', 'productName',
          'quantity', 'unitPrice', 'lineTotal', 'paymentMethod', 'status'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.paymentMethod in ['cod', 'credit']
        && request.resource.data.status in ['pending', 'assigned']
        || (signedIn()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'customerId', 'branchId', 'productId', 'productName',
            'quantity', 'unitPrice', 'lineTotal', 'paymentMethod', 'status'
          ])
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.paymentMethod in ['cod', 'credit']
          && request.resource.data.status == 'pending');

      allow update: if isAdmin()
        || isSupervisor()
        || (isDriver()
          && resource.data.riderId == request.auth.uid
          && (
            (resource.data.status == 'assigned'
              && request.resource.data.status == 'outForDelivery')
            || (resource.data.status == 'outForDelivery'
              && request.resource.data.status == 'riderArrived')
          )
          && request.resource.data.riderId == resource.data.riderId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.branchId == resource.data.branchId)
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'riderArrived'
          && request.resource.data.status == 'delivered'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.productId == resource.data.productId)
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status in [
            'pending', 'supervisorNotified', 'assigned', 'outForDelivery'
          ]
          && request.resource.data.status == 'cancelled'
          && request.resource.data.paymentStatus == 'pending'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.cancelledById == request.auth.uid
          && request.resource.data.cancelledByRole == 'customer');

      allow delete: if isAdmin();
    }

    match /orders/{orderId}/messages/{messageId} {
      function orderData() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      allow read: if isAdmin()
        || isSupervisor()
        || (signedIn() && orderData().customerId == request.auth.uid);

      allow create: if isStaff()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.keys().hasAll([
          'message', 'type', 'createdById', 'createdByName', 'createdByRole'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        || (signedIn()
          && orderData().customerId == request.auth.uid
          && request.resource.data.createdById == request.auth.uid
          && request.resource.data.createdByRole == 'customer'
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && (
            (request.resource.data.type == 'customerMessage'
              && orderData().status in [
                'pending', 'supervisorNotified', 'assigned',
                'outForDelivery', 'riderArrived'
              ])
            || (request.resource.data.type == 'review'
              && orderData().status == 'delivered')
          ));
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'userId', 'title', 'body', 'createdById', 'createdByRole', 'read'
        ])
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByRole in ['admin', 'supervisor', 'driver']
        && request.resource.data.read == false
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body.size() > 0;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.read == true;

      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
