rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userData().role == 'admin';
    }

    function isSupervisor() {
      return signedIn() && userData().role == 'supervisor';
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isSupervisor()
        || (signedIn() && request.auth.uid == userId);

      allow create: if isAdmin()
        || (isSupervisor() && request.resource.data.role == 'driver');

      allow update, delete: if isAdmin()
        || (isSupervisor() && resource.data.role == 'driver')
        || (signedIn() && request.auth.uid == userId);
    }

    match /branches/{branchId} {
      allow read: if isAdmin() || isSupervisor();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
